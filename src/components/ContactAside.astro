---
import { pageByKey, path, type Lang } from '../data/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
---
<aside class="article-aside">
  <h2>{de ? 'Sie möchten Kontakt aufnehmen?' : 'Would you like to get in touch?'}</h2>
  <a class="text-link" href={path(pageByKey.contact[lang])}>{de ? 'Zur Kontaktseite' : 'Go to contact page'} <span aria-hidden="true">↗</span></a>
  <div class="aside-rule"></div>
  <span>Wien · Mödling</span>
</aside>
