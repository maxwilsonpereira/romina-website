---
import { image, pageByKey, path, serviceKeys, sourceLines, type Lang, type Page } from '../data/content';
import ContactForm from './ContactForm.astro';
import ContactAside from './ContactAside.astro';
interface Props { page: Page; lang: Lang }
const { page, lang } = Astro.props;
const de = lang === 'de';
const lines = sourceLines(page, lang).slice(1);
const enHeadings: Record<string, string[]> = {
  offer: ['Areas I work with'], individual: ['Areas of expertise'],
  couples: ['Understanding and changing relationship patterns', 'Space for change'],
  family: ['Finding new ways together', 'Space for every voice'],
  trauma: ['Eye focus / Brainspotting', 'Safety and self-determination'],
  creative: ['From thinking to experiencing', 'Imagination and inner images', 'Meditation and relaxation'],
  alpacas: ['Experiencing relationships, not only talking about them'],
  practical: ['First meeting', 'Who I work with', 'Confidentiality', 'Cancellation', 'Fees'],
  about: ['Training', 'Professional experience', 'My interests']
};
const headings = new Set(de ? page.headings : enHeadings[page.key] ?? []);
const listSection = new Set(de ? ['Meine Themenschwerpunkte', 'Meine Kompetenzbereiche', 'Ausbildungen', 'Arbeitserfahrungen', 'Meine Interessen'] : ['Areas I work with', 'Areas of expertise', 'Training', 'Professional experience', 'My interests']);
const listLead = de ? 'Paartherapie kann dabei unterstützen,' : 'Couples therapy can help you';
const questionStart = de ? 'Was spüre ich gerade?' : 'What am I sensing right now?';
const isListItem = (_line: string, index: number) => {
  if (page.key === 'offer' || page.key === 'individual' || page.key === 'about') {
    let lastHeading = '';
    for (let i = 0; i < index; i++) if (headings.has(lines[i])) lastHeading = lines[i];
    return listSection.has(lastHeading);
  }
  if (page.key === 'couples') {
    const start = lines.indexOf(listLead);
    return index > start && index <= start + 7;
  }
  if (page.key === 'creative') {
    const start = lines.indexOf(questionStart);
    return index >= start && index < start + 4;
  }
  return false;
};
const blocks: { kind: 'heading' | 'paragraph' | 'list'; value: string | string[] }[] = [];
for (let i = 0; i < lines.length; i++) {
  const line = lines[i];
  if (headings.has(line)) blocks.push({ kind: 'heading', value: line });
  else if (isListItem(line, i)) {
    if (blocks.at(-1)?.kind === 'list') (blocks.at(-1)!.value as string[]).push(line);
    else blocks.push({ kind: 'list', value: [line] });
  } else blocks.push({ kind: 'paragraph', value: line });
}
const services = serviceKeys.map((key) => pageByKey[key]);
const isService = serviceKeys.includes(page.key);
const offerHeading = blocks.find((block) => block.kind === 'heading');
const offerTopics = blocks.find((block) => block.kind === 'list');
---
<div class="interior-intro">
  <div class="interior-intro-inner">
    <div class="interior-heading"><a class="back-link" href={path(isService ? pageByKey.offer[lang] : pageByKey.home[lang])}>← {isService ? (de ? 'Therapeutisches Angebot' : 'Therapeutic offer') : (de ? 'Startseite' : 'Home')}</a><h1>{page.title[de ? 0 : 1]}</h1></div>
    {page.image && <div class:list={['interior-image', { 'about-portrait': page.key === 'about' }]}><img src={image(page.image)} alt={page.alt[de ? 0 : 1]} width={page.key === 'about' ? '684' : '1000'} height={page.key === 'about' ? '1024' : '680'} /></div>}
  </div>
</div>
{page.key === 'contact' ? <section class="interior-body"><div class="content-shell contact-page"><div class="location-column"><h2>{de ? 'Praxis Wien' : 'Vienna practice'}</h2><address>Mollardgasse 34/2/40-41<br />1060 {de ? 'Wien' : 'Vienna'}</address><h2>{de ? 'Praxis Mödling' : 'Mödling practice'}</h2><address>Klostergasse 19/5<br />2340 Mödling</address><p><a href="mailto:praxis@psychotherapie-lauzensky.at">praxis@psychotherapie-lauzensky.at</a><br /><a href="tel:+4368184087022">0681/840 870 22</a></p></div><ContactForm lang={lang} /></div></section> : page.key === 'offer' ? <>
<section class="interior-body offer-overview"><div class="content-shell article-layout">
  <article class="prose">{blocks.filter((block) => block.kind === 'paragraph').map((block) => <p>{block.value}</p>)}</article>
  <ContactAside lang={lang} />
</div></section>
<section class="themes-section"><div class="content-shell themes-inner">
  <h2>{offerHeading?.value}</h2>
  {offerTopics && <ul>{(offerTopics.value as string[]).map((topic) => <li>{topic}</li>)}</ul>}
</div></section>
</> : <section class="interior-body"><div class="content-shell article-layout">
  <article class="prose">
    {page.key === 'privacy' && <p class="notice-line">{de ? 'Hinweis zum bisherigen Webauftritt' : 'Notice about the previous website'}</p>}
    {blocks.map((block) => block.kind === 'heading' ? <h2>{block.value}</h2> : block.kind === 'list' ? <ul>{(block.value as string[]).map((item) => <li>{item}</li>)}</ul> : <p>{block.value}</p>)}
    {page.key === 'practical' && <p class="detail-note">{de ? 'Die auf der bisherigen Website genannten Kostenzuschüsse betrugen: BVAEB 50,20 €, SVS 50 €, ÖGK 33,70 € und KfA 37 €. Bitte erfragen Sie die aktuell gültigen Beträge direkt bei Ihrer Kasse.' : 'The previous website listed these reimbursement amounts: BVAEB €50.20, SVS €50, ÖGK €33.70 and KfA €37. Please check current amounts directly with your insurer.'}</p>}
  </article>
  {(page.key !== 'imprint' && page.key !== 'privacy') && <ContactAside lang={lang} />}
</div></section>}
{(page.key === 'offer' || isService) && <section class:list={['service-directory', { 'offer-directory': page.key === 'offer' }]}><div class="content-shell"><h2>{de ? 'Therapeutische Angebote' : 'Therapeutic services'}</h2><div class="service-links">{services.map((service) => <a href={path(service[lang])} aria-current={page.key === service.key ? 'page' : undefined}><span>{service.title[de ? 0 : 1]}</span><span aria-hidden="true">↗</span></a>)}</div></div></section>}
